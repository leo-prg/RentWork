@page "/renters"

@using System.Diagnostics
@using RentLibrary
@inject IHttpService Http
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject IToastService toastService


@inject Blazored.SessionStorage.ISyncSessionStorageService sessionStorage

@inject Service svc
@*<h3>Арендаторы</h3>*@


@if (renters == null)
{
    @*<p><em>Загрузка данных...</em></p>*@
    <div class="text-center">
        <div class="spinner-grow text-primary" style="width: 5rem; height: 5rem;" role="status">
            <span class="sr-only">Загрузка...</span>
        </div>
    </div>
}
else
{
    <div class="form-group">
        @if (svc.allowEdit)
        {
            <div>
                <button class="btn btn-primary mr-3 mb-3 btn-sm" @onclick="(() => OpenModal(new RenterRect { StartPartnership = DateTime.Today, StartDate = DateTime.Today, EndDate = DateTime.Today }))">Новый</button>
                @*<button class="btn btn-primary" @onclick="(() => Refresh() )">Обновить</button>*@
            </div>
        }
        <div>
            <input type="text" class="form-control mb-3" placeholder="введите строку для поиска" @bind="searchStr" @oninput="@((ChangeEventArgs __e) => Search(__e.Value.ToString()))">
            <button class="btn btn-sm btn-info" @onclick="OnShowChange">@btncap</button>
        </div>
    </div>
    @*<div class="form-group">
            <div class="input-group mb-3 mr-3">
                <div class="input-group-prepend">
                    <span class="input-group-text">Поиск</span>
                </div>
                <input type="text" class="form-control" placeholder="введите текст для поиска" @oninput="@((ChangeEventArgs __e) => Search(__e.Value.ToString()))">
            </div>
        </div>*@

    <h5>Всего по списку <span style="color:blue">@count</span> действующих договоров</h5>

    <style>
        tbody {
            display: block;
            height: 68vh;
            overflow: auto;
        }

            thead, tbody tr {
                display: table;
                width: 100%;
                table-layout: fixed;
            }
    </style>

    <table class="table table-hover">
        <thead>
            <tr>
                @if (svc.DevOrProd())
                {
                    <th>ID</th>
                }
                <th @onclick="@(() => renters = Sort("RenterName", renters))">
                    Наименование арендатора
                    <span class="fa @(SetSortIcon("RenterName"))"></span>
                </th>
                <th @onclick="@(() => renters = Sort("ContractNo", renters))">
                    Договор аренды
                    <span class="fa @(SetSortIcon("ContractNo"))"></span>
                </th>
                <th @onclick="@(() => renters = Sort("StartDate", renters))">
                    Дата начала
                    <span class="fa @(SetSortIcon("StartDate"))"></span>
                </th>
                <th @onclick="@(() => renters = Sort("EndDate", renters))">Дата окончания
                <span class="fa @(SetSortIcon("EndDate"))"></span>
                </th>
                <th>Дополнительно</th>
                <th>Примечание</th>
                @if (svc.allowEdit)
                {
                    <th>Действия</th>
                }
            </tr>
        </thead>
        <tbody>

            @foreach (var r in renters)
            {
                @if (r.EndDate.Date < DateTime.Now.Date)
                {
            <tr style="background-color:lightpink @style">
                @if (svc.DevOrProd())
                {
                    <td>@r.Id</td>
                }
                <td><a href="/renterdetails/@r.Id.ToString()">@r.RenterName</a></td>
                <td>@r.Contract</td>
                <td>@r.StartDate.ToString("dd.MM.yyyy")</td>
                <td>@r.EndDate.ToString("dd.MM.yyyy")</td>
                <td><a href="/rareas/@r.Id.ToString()">Площади</a><br /><a href="/renterfiles/@r.Id.ToString()">Документы</a></td>
                <td>@r.Annotation</td>
                @if (svc.allowEdit)
                {
                    <td>
                        <button class="btn btn-sm btn-success" @onclick="(() => OpenModal(r))"><i class="oi oi-pencil" /></button>
                        <button class="btn btn-sm btn-danger" @onclick="(() => Confirm(r))"><i class="oi oi-trash" /></button>
                    </td>
                }
            </tr>
                }
                else
                {
        <tr>
            @if (svc.DevOrProd())
            {
                <td>@r.Id</td>
            }
            <td><a href="/renterdetails/@r.Id.ToString()">@r.RenterName</a></td>
            <td>@r.Contract</td>
            <td>@r.StartDate.ToString("dd.MM.yyyy")</td>
            <td>@r.EndDate.ToString("dd.MM.yyyy")</td>
            <td><a href="/rareas/@r.Id.ToString()">Площади</a><br /><a href="/renterfiles/@r.Id.ToString()">Документы</a></td>
            <td>@r.Annotation</td>
            @if (svc.allowEdit)
            {
                <td>
                    <button class="btn btn-sm btn-success" @onclick="(() => OpenModal(r))"><i class="oi oi-pencil" /></button>
                    <button class="btn btn-sm btn-danger" @onclick="(() => Confirm(r))"><i class="oi oi-trash" /></button>
                </td>
            }
        </tr>
                }

            }
        </tbody>
    </table>

    @if (ShowModal)
    {
        <!-- This is the popup to create or edit a forecast -->
        //<div class="modal position-fixed" role="dialog" style="display:block" >
        <div class="modal show" id="editModal" data-backdrop="true" style="display:block" aria-modal="true" role="dialog" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">Редактирование арендатора</h4>
                        <!-- Button to close the popup -->
                        <button type="button" class="close" @onclick="CloseModal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Наименование</span>
                            </div>
                            <input type="text" class="form-control" @bind="selRenter.RenterName">
                        </div>
                        <br />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Номер договора</span>
                            </div>
                            <input type="text" class="form-control" @bind="selRenter.Contract">
                        </div>
                        <br />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Начало партнерства</span>
                            </div>
                            <input type="date" class="form-control" @bind="selRenter.StartPartnership">
                        </div>
                        <br />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Дата начала</span>
                            </div>
                            <input type="date" class="form-control" @bind="selRenter.StartDate">
                        </div>
                        <br />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Дата окончания</span>
                            </div>
                            <input type="date" class="form-control" @bind="selRenter.EndDate">
                        </div>
                        <br />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Контактные лица</span>
                            </div>
                            <textarea type="text" class="form-control" rows="2" @bind="selRenter.ContactPerson"></textarea>
                        </div>
                        <br />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Контактные данные</span>
                            </div>
                            <textarea type="text" class="form-control" rows="3" @bind="selRenter.ContactPhone"></textarea>
                        </div>
                        <br />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">Примечание</span>
                            </div>
                            <textarea type="text" class="form-control" rows="3" @bind="selRenter.Annotation"></textarea>
                        </div>
                        <br />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success btn-sm" @onclick="(() => SaveRenter(selRenter))">Сохранить</button>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="CloseModal">Отмена</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (ShowConfirm)
    {
        <div class="modal show fade" style="display:block" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="modal-header">
                        <h4 class="modal-title">Подтверждение</h4>
                        <button type="button" class="close" @onclick="( () => { ShowConfirm = !ShowConfirm ; })">&times;</button>
                    </div>

                    <!-- Modal body -->
                    <div class="modal-body">

                        Вы действительно хотите удалить <b>@selRenter.RenterName</b> ?
                    </div>

                    <!-- Modal footer -->
                    <div class="modal-footer">
                        <button type="button" class="btn" @onclick="( () => { ShowConfirm = !ShowConfirm ; })">Отмена</button>
                        <button type="button" class="btn btn-danger" @onclick="( () => { DelRenter(selRenter.Id); })">Удалить</button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

}

@code {

    private bool isSortedAscending;
    private string activeSortColumn = "ContractNo";

    private IEnumerable<RenterRect> renters;

    private RenterRect selRenter;

    private string style = ";display:none";

    private string searchStr = "";

    private int count=0;

    bool ShowModal = false;
    bool ShowConfirm = false;

    bool show = false;
    string btncap = "Показать закрытые/истекшие";

    void OnShowChange()
    {
        show = !show;
        if (show)
        {
            btncap = "Скрыть закрытые/истекшие";
            style = "";
        }
        if (!show)
        {
            btncap = "Показать закрытые/истекшие";
            style = ";display:none";
        }
    }

    private  IEnumerable<T> Sort<T>(string column, IEnumerable<T> set)
    {
        if (column != activeSortColumn)
        {
            isSortedAscending = true;
            activeSortColumn = column;
            return set.OrderBy(x => x.GetType().GetProperty(column).GetValue(x, null)).ToList();

        }
        else
        {

            if (isSortedAscending)
            {
                isSortedAscending = !isSortedAscending;
                return  set.OrderByDescending(x => x.GetType().GetProperty(column).GetValue(x, null)).ToList();
            }
            else
            {
                isSortedAscending = !isSortedAscending;
                return set.OrderBy(x => x.GetType().GetProperty(column).GetValue(x, null)).ToList();
            }

        }

    }

    protected override async Task OnInitializedAsync()
    {

        await RefreshList();
    }

    async void Search(string ss)
    {
        searchStr = ss;
        sessionStorage.SetItem<string>("searchStr", ss);
        renters = (await Http.Get<IEnumerable<RenterRect>>(ConnectAPI.apiUri + "/api/Renters")).Where(r => r.RenterName.ToUpper().Contains(ss.ToUpper())).Select(r => r);


        if (renters.Count() == 0)
        {
            toastService.ShowToast(ToastLevel.Error, "Ничего не найдено", "Ошибка");
        }
        StateHasChanged();
    }

    private async Task RefreshList()
    {
        string str = sessionStorage.GetItem<string>("searchStr");

        renters = await Http.Get<IEnumerable<RenterRect>>(ConnectAPI.apiUri + "/api/Renters");
        renters = Sort("RenterName", renters);
        if (str != null) Search(str);



        count = 0;
        foreach (var r in renters)
        {


            if ((r.EndDate.Date > DateTime.Now.Date) && (r.StartDate.Date < DateTime.Now.Date))
            {
                count++;
            }
        }
        StateHasChanged();
    }

    void OpenModal(RenterRect renter)
    {
        ShowModal = true;
        selRenter = renter;
    }

    void CloseModal()
    {
        ShowModal = false;
        selRenter = null;
    }

    async void DelRenter(int id)
    {
        ShowConfirm = false;
        await Http.Delete(ConnectAPI.apiUri + "/api/Renters?id=" + id);
        await RefreshList();
    }

    async void SaveRenter(RenterRect newRenter)
    {
        ShowModal = false;
        // проверить ИД если есть значит редактирование, если нету - значит новый арендатор
        if (newRenter.Id > 0)
        {
            await Http.Put(ConnectAPI.apiUri + "/api/Renters", newRenter);
        }
        else
        {
            await Http.Post(ConnectAPI.apiUri + "/api/Renters", newRenter);
        }
        await RefreshList();
    }

    void Confirm(RenterRect renter)
    {
        ShowConfirm = true;
        selRenter = renter;
    }

    private string SetSortIcon(string columnName)
    {
        if (activeSortColumn != columnName)
        {
            return string.Empty;
        }
        if (isSortedAscending)
        {
            return "fa-sort-up";
        }
        else
        {
            return "fa-sort-down";
        }
    }

}

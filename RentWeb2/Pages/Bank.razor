@page "/Bank"


@if (showPwd)
{
    <div class="input-group mb-3">
        <div class="input-group-prepend">
            <span class="input-group-text">Введите пароль для доступа к банковской информации</span>
        </div>
        <input type="password" class="form-control" width="100" placeholder="пароль"
               @oninput="@((ChangeEventArgs __e) => { if (__e.Value.ToString() == "200002167") { showPwd = false; showBank = true; } })">
    </div>
}

@if (showBank)
{


<ul class="nav nav-pills nav-fill">

    <li class="nav-item">
        <a class="@(act == 1 ? "nav-link active" : "nav-link")" style="margin-bottom:10px" target="mainreport" href="@bank_deposit" @onclick="() => { act = 1; }">Расчетные счета счета</a>
    </li>

    <li class="nav-item">
        <a class="@(act == 0 ? "nav-link active" : "nav-link")" style="margin-bottom:10px" target="mainreport" href="@bank_current" @onclick="() => { act = 0; }">Платежи</a>
    </li>

    <li class="nav-item">
        <a class="@(act == 2 ? "nav-link active" : "nav-link")" style="margin-bottom:10px" target="mainreport" href="@bank_credit" @onclick="() => { act = 2; }">Кредит АСБ "Беларусбанк"</a>
    </li>

    <iframe name="mainreport" style="width:100%;  height: 90vh; border: none"></iframe>
</ul>

 
}

@code
{
    private byte act = 2;
    bool showPwd = false;
    bool showBank = true;
    private string bank_current= ConnectAPI.reportUri + "/ReportServer/Pages/ReportViewer.aspx?%2f%d0%9e%d1%82%d1%87%d0%b5%d1%82%d1%8b%2fBank&rs:Command=Render";
    private string bank_deposit = ConnectAPI.reportUri + "/ReportServer/Pages/ReportViewer.aspx?%2fОтчеты%2fBankCurrency&rs:Command=Render";
    private string bank_credit = ConnectAPI.reportUri + "/ReportServer/Pages/ReportViewer.aspx?%2fОтчеты%2fBankCredit&rs:Command=Render";
}

@page "/analysis"

<ul class="nav nav-pills nav-fill">

    <li class="nav-item">
        <a class="@(act == 0 ? "nav-link active" : "nav-link")" style="margin-bottom:10px" target="mainreport" href="@report_rent" @onclick="() => { act = 0; }">Аренда за последние 6 месяцев</a>
    </li>

    <li class="nav-item">
        <a class="@(act == 1 ? "nav-link active" : "nav-link")" style="margin-bottom:10px" target="mainreport" href="@report_rent_ext" @onclick="() => { act = 1; }">Аренда в сравнении с прошлым годом</a>
    </li>

    <li class="nav-item">
        <a class="@(act == 2 ? "nav-link active " : "nav-link")" style="margin-bottom:10px" target="mainreport" href="@report_deposit" @onclick="() => { act = 2; }">Банковские депозиты</a>
    </li>

    <iframe name="mainreport" style="width:100%;  height: 90vh; border: none"></iframe>
</ul>


@code
{

    private byte act = 99;

    private string report_rent = ConnectAPI.reportUri + "/ReportServer/Pages/ReportViewer.aspx?%2fОтчеты%2fАнализ+доходов+от+аренды&rs:Command=Render";
    private string report_rent_ext = ConnectAPI.reportUri + "/ReportServer/Pages/ReportViewer.aspx?%2fОтчеты%2fРасширенный+анализ+доходов+аренды&rs:Command=Render";
    private string report_deposit = ConnectAPI.reportUri + "/ReportServer/Pages/ReportViewer.aspx?%2fОтчеты%2fДоходы+от+депозитов+в+банках&rs:Command=Render";


}
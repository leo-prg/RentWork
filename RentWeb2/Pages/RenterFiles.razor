@page "/renterfiles/{id}"

@using System.Diagnostics
@using RentLibrary
@using BlazorInputFile
@using BlazorDownloadFile
@using System.IO
@using System.Text.Json;
@using System.Text.Json.Serialization;
@using Blazored.LocalStorage;

@inject IHttpService Http
@inject NavigationManager NavigationManager
@inject Service svc



@if (fileList == null)
{
    @*<p><em>Loading...</em></p>*@
    <div class="text-center">
        <div class="spinner-grow text-primary" style="width: 5rem; height: 5rem;" role="status">
            <span class="sr-only">Загрузка...</span>
        </div>
    </div>
}
else
{
    <h4 style="color:darkgreen">Документы по арендатору @selRenter.RenterName</h4>

    @if (svc.allowEdit)
    {
        <div>
            <button class="btn btn-primary mr-3 mb-3 btn-sm" @onclick="() => ShowModal = true">Добавить</button>
        </div>
    }

    @*<span>@status</span>
        <select @bind="descr">
            <option>Договор</option>
            <option>Дополнительное соглашение</option>
            <option>Другое</option>
        </select>
        <button class="btn btn-sm btn-success" type="button" @onclick="() => LoadFile(file)">
            Загрузить
        </button>*@

    <table class="table table-hover">
        <thead>
            <tr>
                @if (svc.DevOrProd())
                {
                    <th>ID</th>
}
                <th>Описание</th>
                <th>Имя файла</th>
                <th>Тип файла</th>
                <th>Размер файла, байт</th>
                <th>Дата последнего изменения</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in fileList)
            {
                <tr>
                    @if (svc.DevOrProd())
                    {
                        <td>@l.Id</td>
}
                    <td>@l.Description</td>
                    <td>@l.FileName</td>
                    <td>@l.FileType</td>
                    <td>@l.FileSize</td>
                    <td>@l.Modified</td>
                    <td>
                        <button class="btn btn-sm btn-primary" type="button" @onclick="() => Download(l.Id, l.FileName)"><i class="oi oi-data-transfer-download" /></button>
                        @if (svc.allowEdit)
                        {
                            <button class="btn btn-sm btn-danger" type="button" @onclick="(() => { ShowConfirm = true; delId = l.Id; })"><i class="oi oi-trash" /></button>
                        }
                        </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />
    <p>
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.history.go(-1)">Назад</button>
    </p>


    @if (ShowModal)
    {
        <div class="modal show" id="editModal" data-backdrop="true" style="display:block" aria-modal="true" role="dialog" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">Добавление файла</h4>
                        <!-- Button to close the popup -->
                        <button type="button" class="close" @onclick="() => ShowModal = false">&times;</button>
                    </div>
                    <div class="modal-body">
                        <InputFile OnChange="HandleSelection" />
                        <br />
                        <span>@status</span>
                        <br />
                        <div>
                            <span>Тип документа</span>
                            <select @bind="descr">
                                <option style="display:none">...</option>
                                <option>Договор</option>
                                <option>Дополнительное соглашение</option>
                                <option>Приложение</option>
                                <option>Другое</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success btn-sm" @onclick="(() => LoadFile(file))">Сохранить</button>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => ShowModal = false">Отмена</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }


    @if (ShowConfirm)
    {
        <div class="modal show fade" style="display:block" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="modal-header">
                        <h4 class="modal-title">Подтверждение</h4>
                        <button type="button" class="close" @onclick="( () => { ShowConfirm = !ShowConfirm ; })">&times;</button>
                    </div>

                    <!-- Modal body -->
                    <div class="modal-body">

                        Вы действительно хотите удалить документ ?
                    </div>

                    <!-- Modal footer -->
                    <div class="modal-footer">
                        <button type="button" class="btn" @onclick="( () => { ShowConfirm = !ShowConfirm ; })">Отмена</button>
                        <button type="button" class="btn btn-danger" @onclick=" async () =>  await Kill(delId) ">Удалить</button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }


}

@code {

    [Inject] public IBlazorDownloadFileService BlazorDownloadFileService { get; set; }

    [Parameter]
    public string id { get; set; }

  //  private ILocalStorageService _localStorageService;
    private RenterRect selRenter;
    private IEnumerable<RenterFileList> fileList;

    int delId;

    private IFileListEntry file;

    private string descr;

    string status;

    bool ShowModal = false;
    bool ShowConfirm = false;

    void HandleSelection(IFileListEntry[] files)
    {
        file = files.FirstOrDefault();
        if (file != null)
        {
            status = $"Будет загружен файл {file.Name}";
            // размером {file.Size} байт, изменен: {file.LastModified}, тип файла {file.Type}
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
    }

    private async Task RefreshList()
    {
        fileList = await Http.Get<List<RenterFileList>>(ConnectAPI.apiUri + "/api/Renters/GetRenterFileList?id=" + id);
        selRenter = await Http.Get<RenterRect>(ConnectAPI.apiUri + "/api/Renters/" + id);
        StateHasChanged();
    }

    async Task LoadFile(IFileListEntry file)
    {
        file.OnDataRead += (sender, eventArgs) => InvokeAsync(StateHasChanged);

        using (var _content = new MultipartFormDataContent())
        {
            _content.Add(new StreamContent(file.Data), "f", file.Name);
            _content.Add(new StringContent(JsonSerializer.Serialize(new RenterFileList()
            { Description = descr, FileName = file.Name, FileType = file.Type, FileSize = file.Size, Modified = file.LastModified })), "rf");
            await Http.Post(ConnectAPI.apiUri + "/api/Renters/AddRenterFile?id=" + selRenter.Id, _content);
        }

        await RefreshList();
        ShowModal = false;
        file = null;
        status = "";

    }

    async Task Download(int id, string name)
    {
        var response = await Http.GetFile(ConnectAPI.apiUri + "/api/Renters/DownloadFile/" + id);
        await BlazorDownloadFileService.DownloadFile(name, response, "application/octet-stream");
    }

    async Task Kill(int id)
    {
        Debug.WriteLine(id);
        await Http.Post(ConnectAPI.apiUri + "/api/Renters/KillFile/" + id, null);
        await RefreshList();
        ShowConfirm = false;
    }




}

@inject IAuthenticationService AuthenticationService
<div class="top-row pl-4 navbar navbar-dark align-content-center">
    <a class="navbar-brand" style="" href="">@CurDT</a>

   
</div>

<div >
    <ul class="nav flex-column">
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Главная
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link">
                <span class="oi oi-key" aria-hidden="true"></span>Недвижимость
            </NavLink>
            <ul>
                <li class="nav-item px-3 list-unstyled">
                    <NavLink class="nav-link" href="orent">
                        <span class="oi oi-briefcase" aria-hidden="true"></span>Объекты
                    </NavLink>
                </li>
                <li class="nav-item px-3 list-unstyled">
                    <NavLink class="nav-link" href="areas">
                        <span class="oi oi-layers" aria-hidden="true"></span>Схемы
                    </NavLink>
                </li>
            </ul>
        </li>

        <li class="nav-item px-3">
            <NavLink class="nav-link" href="renters">
                <span class="oi oi-people" aria-hidden="true"></span>Арендаторы
            </NavLink>
        </li>

        <li class="nav-item px-3">
            <NavLink class="nav-link">
                <span class="oi oi-print" aria-hidden="true"></span>Отчеты
            </NavLink>
            <ul>
                <li class="nav-item px-3 list-unstyled">
                    <NavLink class="nav-link" href="reports">
                        <span class="oi oi-pulse" aria-hidden="true"></span>
                        Аренда
                    </NavLink>
                </li>

                <li class="nav-item px-3 list-unstyled">
                    <NavLink class="nav-link" href="analysis">
                        <span class="oi oi-bar-chart" aria-hidden="true"></span>
                        Доходы
                    </NavLink>
                </li>

                @if (accessBank.Contains(AuthenticationService.User.Username))
                {
                    <li class="nav-item px-3 list-unstyled">
                        <NavLink class="nav-link" href="bank">
                            <span class="oi oi-dollar" aria-hidden="true"></span>
                            Банк
                        </NavLink>
                    </li>
                }
            </ul>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link">
                <span class="oi oi-wrench" aria-hidden="true"></span>Настройка
            </NavLink>
            <ul>
                @if (accessAdmin.Contains(AuthenticationService.User.Username))
                {
                    <li class="nav-item px-3 list-unstyled">
                        <NavLink class="nav-link" href="users">
                            <span class="oi oi-shield" aria-hidden="true"></span>
                            Пользователи
                        </NavLink>
                    </li>
                }
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="settings">
                        <span class="oi oi-puzzle-piece" aria-hidden="true"></span>
                        Параметры
                    </NavLink>
                </li>
            </ul>
        </li>
    </ul>
</div>

@code {

    private string[] accessBank = { "ivan", "leo", "tatjana", "alex"};
    private string[] accessAdmin = { "leo" };

    private string CurDT =  String.Format("{0:D}", DateTime.Now);

}

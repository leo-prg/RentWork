@inherits LayoutComponentBase
@inject IAuthenticationService AuthenticationService
@inject NavigationManager NavigationManager
@inject Service svc



@using Microsoft.AspNetCore.Authorization




@if (AuthenticationService.User != null)
{
    <div class="sidebar overflow-hidden">
        <NavMenu />
    </div>
}

<div class="main overflow-auto">

    <div class="top-row" style="display: flex; justify-content: space-between; align-items: center;">
        <a href="http://krokooo.by" target="_blank"><img src="logo-w.png" width="50" height="50" /></a>
        <h3>Аренда коммерческой недвижимости</h3>
        @if (AuthenticationService.User != null)
        {
            <a href="logout">@AuthenticationService.User.FirstName</a>
        }
    </div>
    <div class="content px-4">
        @Body
    </div>
</div>

<BlazoredToasts />
